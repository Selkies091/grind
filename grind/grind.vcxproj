  <PropertyGroup Label="UserMacros">
    <MySqlConnDir>C:\Program Files\MySQL\MySQL Connector C++ 9.6</MySqlConnDir>
    <SqliteDir>C:\Program Files\sqlite</SqliteDir>
    <CopyMySqlDlls>xcopy /y /d "$(MySqlConnDir)\lib64\mysqlcppconnx-2-vs14.dll" "$(OutDir)"
xcopy /y /d "$(MySqlConnDir)\lib64\libssl-3-x64.dll" "$(OutDir)"
xcopy /y /d "$(MySqlConnDir)\lib64\libcrypto-3-x64.dll" "$(OutDir)"</CopyMySqlDlls>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
