      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>$(CoreLibraryDependencies);%(AdditionalDependencies);$(MySqlConnDir)\lib64\vs14\mysqlcppconnx.lib</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>$(CopyMySqlDlls)</Command>
      <Message>Copying MySQL Connector/C++ runtime DLLs</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
