    <RootNamespace>grind</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <!-- vcpkg (manifest mode): dependencies are listed in vcpkg.json and installed on build.
       Uses the copy of vcpkg bundled with Visual Studio unless VCPKG_ROOT is set. -->
  <PropertyGroup Label="Vcpkg">
    <VcpkgRoot Condition="'$(VcpkgRoot)' == '' and '$(VCPKG_ROOT)' != ''">$(VCPKG_ROOT)\</VcpkgRoot>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == ''">$(DevEnvDir)..\..\VC\vcpkg\</VcpkgRoot>
    <VcpkgRoot Condition="!Exists('$(VcpkgRoot)vcpkg.exe')">C:\Program Files\Microsoft Visual Studio\18\Community\VC\vcpkg\</VcpkgRoot>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
    <!-- Copy dependency DLLs next to the exe with vcpkg's built-in tool instead of
         applocal.ps1 (which looks for pwsh.exe first and logs noise when it's missing). -->
    <VcpkgXUseBuiltInApplocalDeps>true</VcpkgXUseBuiltInApplocalDeps>
    <!-- Always use vcpkg's release libraries: the MySQL connector only ships release-CRT
         binaries, so every configuration here builds against the release CRT (/MD). -->
    <VcpkgConfiguration>Release</VcpkgConfiguration>
    <!-- Only x64 is set up for MySQL; don't build x86 packages for the Win32 configs. -->
    <VcpkgEnabled Condition="'$(Platform)' != 'x64'">false</VcpkgEnabled>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
